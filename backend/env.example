# Sejahtera Bersama IMS — environment template
# Copy:  cp env.example .env
# Never commit .env. Generate SECRET_KEY:  python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# --- Django core ---
# Required in production (DEBUG false/0): set a long random string
SECRET_KEY=change-me-to-secure-random-key

# true/1/yes/on = development; false/0 = production
DEBUG=True

# Comma-separated hostnames/IPs (no spaces). Required behind a public domain.
# localhost / 127.0.0.1 are added automatically in settings for health probes — you do not need to list them.
# Example production:
# ALLOWED_HOSTS=api.sejahterabersama.my.id
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Used by docker-compose / docker-compose.prod (Postgres service + DATABASE_URL build).
# In containers, compose sets DATABASE_URL; you normally do not set DATABASE_URL in .env unless you override.
# IMPORTANT:
# - Keep SQL_DATABASE / SQL_USER / SQL_PASSWORD consistent with your running Postgres volume.
# - If you change these after first boot, old data volume may reject login (password auth failed).
# - To apply new credentials on local dev, recreate db volume: docker compose down -v
SQL_DATABASE=sejahteraims
SQL_USER=postgres
SQL_PASSWORD=password

# Optional: only if you customize entrypoint/compose (default in Docker: host db, port 5432)
# SQL_HOST=db
# SQL_PORT=5432

# Local run without Docker, or custom URL (django-environ format):
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# DATABASE_URL=sqlite:///db.sqlite3

# --- HTTPS (set to True/1 after TLS is working; nginx terminates SSL in production) ---
# /health/ is exempt from SECURE_SSL_REDIRECT (see settings.py) so deploy probes over HTTP still work.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Comma-separated full origins with scheme (HTTPS in production).
# Required for cookie auth / admin forms behind HTTPS. Does NOT affect /health/ or server-side deploy checks.
# Example production:
# CSRF_TRUSTED_ORIGINS=https://www.sejahterabersama.my.id,https://api.sejahterabersama.my.id

# --- CORS (browser-only — does not affect curl, Docker healthchecks, or CI deploy probes) ---
# Must list the exact frontend origin(s), comma-separated, no spaces.
# Local dev (Vite default port 3000):
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Example production (Vercel SPA):
# CORS_ALLOWED_ORIGINS=https://www.sejahterabersama.my.id,https://sejahtera-bersama.vercel.app

# --- Celery & Redis ---
# In Docker, compose sets CELERY_BROKER_URL; override only if needed.
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- JWT (optional; defaults are fine for most deployments) ---
# JWT_ACCESS_MINUTES=15
# JWT_REFRESH_DAYS=90
# JWT_ACCESS_COOKIE_NAME=ims_access
# JWT_REFRESH_COOKIE_NAME=ims_refresh

# --- DRF throttling (optional) ---
# DRF_THROTTLE_ANON=30/min
# DRF_THROTTLE_USER=120/min
# DRF_THROTTLE_AUTH=10/min
# DRF_THROTTLE_AUTH_PUBLIC=5/min

# --- CI/CD (set automatically by deploy-registry.sh after a successful registry deploy) ---
# APP_IMAGE=ghcr.io/<github-owner>/sejahtera-ims-api:<commit-sha>
#

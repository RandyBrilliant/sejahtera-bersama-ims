# Nevacloud Object Storage — database backup credentials
# Copy to project root (next to .env):
#   cp deploy/env.backup-s3.example .backup-s3.env
#   chmod 600 .backup-s3.env
#
# IMPORTANT: Keep this file separate from .env — .env is loaded into Docker containers.

# S3 bucket name (lowercase, created in Nevacloud portal)
BACKUP_S3_BUCKET=your-bucket-name

# Access key pair from Nevacloud Object Storage → Access Keys
BACKUP_S3_ACCESS_KEY_ID=your-access-key-id
BACKUP_S3_SECRET_ACCESS_KEY=your-secret-access-key

# Nevacloud S3 endpoint (default is correct for Nevaobjects)
BACKUP_S3_ENDPOINT=https://s3.nevaobjects.id
BACKUP_S3_REGION=ap-southeast-1

# S3 addressing style for Nevacloud (path is required; do not use virtual)
BACKUP_S3_ADDRESSING_STYLE=path

# Folder prefix inside the bucket (no leading slash)
BACKUP_S3_PREFIX=sejahtera-ims/db-backups

# Delete remote backups older than this many days (default: 30)
BACKUP_RETENTION_DAYS=30
